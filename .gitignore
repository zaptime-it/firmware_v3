# IDE / OS
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.DS_Store

# Node / webui
node_modules
data/build
data/build/*
data/.yarn
data/node_modules

# IDF managed components are downloaded under firmware/managed_components/
# by the Component Manager on every configure — never tracked.
managed_components

# IDF builds. Each variant lands in build_<variant>/ at repo root
# because firmware/build.sh invokes `idf.py -B ../build_<variant>`.
/build/
/build_*/
/compile_commands.json

# IDF-as-build flow generated artefacts under firmware/. The tracked
# scaffold (CMakeLists.txt, main/, sdkconfig.defaults*, arduino_libraries.json,
# fetch_arduino_libs.py, partition*.csv, dependencies.lock, build*.sh)
# is the firmware build's single source of truth; everything below is
# regenerated on demand.
firmware/build_*/
firmware/arduino_libraries/
firmware/sdkconfig
firmware/spiffs/

# Host-test CMake build trees (configured from tests/CMakeLists.txt).
# Plain and sanitize variants both regenerate on every configure.
/build-tests/
/build-tests-asan/

# CI release staging dir produced by firmware/build-release.sh
/release-stage/

# Font/asset conversion byproducts that end up at the repo root while
# experimenting with tools/ helpers. The real source files live under
# data/ or src/fonts/; nothing at the root needs to be tracked.
/*.c
/*.c.gz
/*.bin.gz
/*.new.gz

# Scratch notes / dumps developers tend to leave lying around.
events_to_delete*.txt
new.txt
new[0-9].txt
settings.csv
/get_fs.sh
/convert.sh
/convert-os.sh
/compress_icons.py
/process_timezone_data.py
/verify_timezone_data.py

# tools/ is a scratch area for local asset/font/timezone helpers that
# aren't part of the build.
/tools/
