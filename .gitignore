# IDE / OS
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.DS_Store

# Node / webui
node_modules
data/build
data/build/*
data/.yarn
data/node_modules

# IDF managed components are downloaded under managed_components/ by the
# Component Manager on every configure — never tracked.
managed_components

# IDF builds. Each variant lands in build_<variant>/ at repo root because
# scripts/build.sh invokes `idf.py -B build_<variant>` from there.
/build/
/build_*/
/compile_commands.json

# Vendored Arduino libraries — fetched on demand by
# scripts/fetch_arduino_libs.py from arduino_libraries.json. The JSON
# spec IS tracked; the populated arduino_libraries/ tree is not.
/arduino_libraries/

# Generated IDF sdkconfig (chained from the tracked
# sdkconfig.defaults + sdkconfig.defaults.<variant>).
/sdkconfig

# LittleFS staging dir for ad-hoc image builds.
/spiffs/

# Host-test CMake build trees (configured from tests/CMakeLists.txt).
# Plain and sanitize variants both regenerate on every configure.
/build-tests/
/build-tests-asan/

# CI release staging dir produced by scripts/build-release.sh
/release-stage/

# Font/asset conversion byproducts that end up at the repo root while
# experimenting with tools/ helpers. The real source files live under
# data/ or src/fonts/; nothing at the root needs to be tracked.
/*.c
/*.c.gz
/*.bin.gz
/*.new.gz

# Scratch notes / dumps developers tend to leave lying around.
events_to_delete*.txt
new.txt
new[0-9].txt
settings.csv
/get_fs.sh
/convert.sh
/convert-os.sh
/compress_icons.py
/process_timezone_data.py
/verify_timezone_data.py

# tools/ is a scratch area for local asset/font/timezone helpers that
# aren't part of the build.
/tools/
